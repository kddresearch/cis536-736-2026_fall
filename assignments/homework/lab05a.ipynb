   "source": [
    "## Part 2: Open-Weight Generative Geometry (`Point-E` / `Shap-E`) & OpenUSD Conversion (MP 7 Part 1)\n",
    "Per the course's open-weight local-execution requirement, **MP 7 Part 1** requires you to:\n",
    "1. Generate **2 candidate 3D outputs** locally using `Shap-E` (implicit SDF/NeRF parameters rendered to meshes) or `Point-E` (text/image-to-point-cloud diffusion) across two different prompts or random seeds.\n",
    "2. Critique the geometric and topological quality of both candidates.\n",
    "3. Convert the selected mesh into an **OpenUSD (`.usda` / `.usdc`)** asset with clean vertex/face topology and meter-scale metadata (`metersPerUnit = 1.0`, `upAxis = \"Y\"`) for import into **Unity 6**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Optional setup if Point-E / Shap-E / usd-core are not yet installed in your local conda env:\n",
    "# !pip install -q usd-core trimesh scikit-image\n",
    "# !pip install -q git+https://github.com/openai/point-e.git\n",
    "# !pip install -q git+https://github.com/openai/shap-e.git\n",
    "\n",
    "WORKSPACE = Path.cwd() / \"lab5a_workspace\"\n",
    "GEN_DIR = WORKSPACE / \"part1_generative_geometry\"\n",
    "GEN_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def generate_shap_e_candidates(\n",
    "    prompt_a: str = \"a low-poly stone lantern with a hexagonal roof\",\n",
    "    prompt_b: str = \"a weathered medieval wooden barrel with iron bands\",\n",
    "    seed_a: int = 42,\n",
    "    seed_b: int = 137,\n",
    "    guidance_scale: float = 15.0,\n",
    "    steps: int = 64\n",
    "):\n",
    "    \"\"\"\n",
    "    Runs local open-weight Shap-E text-to-3D generation for 2 candidate prompts/seeds\n",
    "    within an 8GB VRAM envelope (fp16扩散 + latent decoding to triangle mesh).\n",
    "    Falls back to a deterministic procedural proxy mesh if Shap-E weights are offline.\n",
    "    \"\"\"\n",
    "    candidates = [\n",
    "        (\"candidate_1\", prompt_a, seed_a),\n",
    "        (\"candidate_2\", prompt_b, seed_b),\n",
    "    ]\n",
    "    exported_meshes = {}\n",
    "\n",
    "    try:\n",
    "        from shap_e.diffusion.sample import sample_latents\n",
    "        from shap_e.diffusion.gaussian_diffusion import diffusion_from_config\n",
    "        from shap_e.models.download import load_model, load_config\n",
    "        from shap_e.util.notebooks import decode_latent_mesh\n",
    "\n",
    "        device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "        xm = load_model(\"transmitter\", device=device)\n",
    "        model = load_model(\"text300M\", device=device)\n",
    "        diffusion = diffusion_from_config(load_config(\"diffusion\"))\n",
    "\n",
    "        for tag, prompt, seed in candidates:\n",
    "            torch.manual_seed(seed)\n",
    "            print(f\"[Shap-E] Sampling {tag}: prompt='{prompt}' (seed={seed})...\")\n",
    "            latents = sample_latents(\n",
    "                batch_size=1,\n",
    "                model=model,\n",
    "                diffusion=diffusion,\n",
    "                guidance_scale=guidance_scale,\n",
    "                model_kwargs=dict(texts=[prompt]),\n",
    "                progress=True,\n",
    "                clip_denoised=True,\n",
    "                use_fp16=(device.type == \"cuda\"),\n",
    "                use_karras=True,\n",
    "                karras_steps=steps,\n",
    "                sigma_min=1e-3,\n",
    "                sigma_max=160,\n",
    "                s_churn=0,\n",
    "            )\n",
    "            mesh = decode_latent_mesh(xm, latents[0]).tri_mesh()\n",
    "            obj_path = GEN_DIR / f\"{tag}.obj\"\n",
    "            with open(obj_path, \"w\") as f:\n",
    "                mesh.write_obj(f)\n",
    "            exported_meshes[tag] = {\n",
    "                \"prompt\": prompt,\n",
    "                \"seed\": seed,\n",
    "                \"vertices\": np.asarray(mesh.verts, dtype=np.float32),\n",
    "                \"faces\": np.asarray(mesh.faces, dtype=np.int32),\n",
    "                \"obj_path\": obj_path,\n",
    "            }\n",
    "        # Free VRAM before Part 4 gsplat training\n",
    "        del xm, model, latents\n",
    "        if torch.cuda.is_available():\n",
    "            torch.cuda.empty_cache()\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"[Info] Shap-E runtime not loaded ({e}). Generating deterministic proxy meshes for pipeline verification.\")\n",
    "        for idx, (tag, prompt, seed) in enumerate(candidates):\n",
    "            rng = np.random.default_rng(seed)\n",
    "            # Generate a deterministic displaced icosahedral/cylindrical mesh\n",
    "            angles = np.linspace(0, 2 * np.pi, 16, endpoint=False)\n",
    "            z_levels = np.linspace(-0.5, 0.5, 6)\n",
    "            verts = []\n",
    "            for z in z_levels:\n",
    "                r = 0.4 + 0.05 * np.cos(np.pi * z) + rng.normal(0, 0.01)\n",
    "                for a in angles:\n",
    "                    verts.append([r * np.cos(a), z + 0.5, r * np.sin(a)])\n",
    "            verts = np.asarray(verts, dtype=np.float32)\n",
    "            faces = []\n",
    "            n_ring = len(angles)\n",
    "            for level in range(len(z_levels) - 1):\n",
    "                for i in range(n_ring):\n",
    "                    i_next = (i + 1) % n_ring\n",
    "                    v0 = level * n_ring + i\n",
    "                    v1 = level * n_ring + i_next\n",
    "                    v2 = (level + 1) * n_ring + i_next\n",
    "                    v3 = (level + 1) * n_ring + i\n",
    "                    faces.append([v0, v1, v2])\n",
    "                    faces.append([v0, v2, v3])\n",
    "            faces = np.asarray(faces, dtype=np.int32)\n",
    "            exported_meshes[tag] = {\n",
    "                \"prompt\": prompt,\n",
    "                \"seed\": seed,\n",
    "                \"vertices\": verts,\n",
    "                \"faces\": faces,\n",
    "                \"obj_path\": GEN_DIR / f\"{tag}_proxy.obj\",\n",
    "            }\n",
    "\n",
    "    for tag, info in exported_meshes.items():\n",
    "        v_cnt = len(info[\"vertices\"])\n",
    "        f_cnt = len(info[\"faces\"])\n",
    "        bbox_min = info[\"vertices\"].min(axis=0).round(3)\n",
    "        bbox_max = info[\"vertices\"].max(axis=0).round(3)\n",
    "        print(f\"  -> {tag}: {v_cnt} vertices, {f_cnt} triangles | BBox: {bbox_min} to {bbox_max}\")\n",
    "    return exported_meshes\n",
    "\n",
    "candidates_dict = generate_shap_e_candidates()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def export_mesh_to_openusd(vertices: np.ndarray, faces: np.ndarray, usd_path: Path, prim_name: str = \"GenerativeAsset\"):\n",
    "    \"\"\"\n",
    "    Converts a triangle mesh (vertices Nx3, faces Mx3) into an OpenUSD (.usda) stage\n",
    "    configured for Unity 6 / Blender 4.2 interchange (Y-up, 1.0 metersPerUnit).\n",
    "    \"\"\"\n",
    "    try:\n",
    "        from pxr import Usd, UsdGeom, Vt, Gf, Sdf\n",
    "        if usd_path.exists():\n",
    "            usd_path.unlink()\n",
    "        stage = Usd.Stage.CreateNew(str(usd_path))\n",
    "        UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.y)\n",
    "        UsdGeom.SetStageMetersPerUnit(stage, 1.0)\n",
    "\n",
    "        root_xform = UsdGeom.Xform.Define(stage, Sdf.Path(f\"/{prim_name}\"))\n",
    "        stage.SetDefaultPrim(root_xform.GetPrim())\n",
    "\n",
    "        mesh_prim = UsdGeom.Mesh.Define(stage, Sdf.Path(f\"/{prim_name}/Geometry\"))\n",
    "        points_vt = Vt.Vec3fArray([Gf.Vec3f(float(v[0]), float(v[1]), float(v[2])) for v in vertices])\n",
    "        counts_vt = Vt.IntArray([3] * len(faces))\n",
    "        indices_vt = Vt.IntArray(faces.flatten().tolist())\n",
    "\n",
    "        mesh_prim.CreatePointsAttr(points_vt)\n",
    "        mesh_prim.CreateFaceVertexCountsAttr(counts_vt)\n",
    "        mesh_prim.CreateFaceVertexIndicesAttr(indices_vt)\n",
    "        mesh_prim.CreateSubdivisionSchemeAttr().Set(UsdGeom.Tokens.none)\n",
    "\n",
    "        stage.GetRootLayer().Save()\n",
    "        print(f\"[OpenUSD] Saved stage via pxr: {usd_path} (DefaultPrim=/{prim_name})\")\n",
    "    except ImportError:\n",
    "        # Fallback ASCII .usda writer if usd-core is not installed in the active kernel\n",
    "        pts_str = \", \".join([f\"({v[0]:.4f}, {v[1]:.4f}, {v[2]:.4f})\" for v in vertices])\n",
    "        cnt_str = \", \".join([\"3\"] * len(faces))\n",
    "        idx_str = \", \".join([str(int(i)) for i in faces.flatten()])\n",
    "        usda_text = f'''#usda 1.0\n",
    "(\n",
    "    defaultPrim = \"{prim_name}\"\n",
    "    metersPerUnit = 1.0\n",
    "    upAxis = \"Y\"\n",
    ")\n",
    "\n",
    "def Xform \"{prim_name}\"\n",
    "{{\n",
    "    def Mesh \"Geometry\"\n",
    "    {{\n",
    "        int[] faceVertexCounts = [{cnt_str}]\n",
    "        int[] faceVertexIndices = [{idx_str}]\n",
    "        point3f[] points = [{pts_str}]\n",
    "        uniform token subdivisionScheme = \"none\"\n",
    "    }}\n",
    "}}\n",
    "'''\n",
    "        usd_path.write_text(usda_text, encoding=\"utf-8\")\n",
    "        print(f\"[OpenUSD] Saved ASCII .usda stage: {usd_path} (DefaultPrim=/{prim_name})\")\n",
    "\n",
    "selected = candidates_dict[\"candidate_1\"]\n",
    "usd_output_path = GEN_DIR / \"mp7_generative_asset.usda\"\n",
    "export_mesh_to_openusd(selected[\"vertices\"], selected[\"faces\"], usd_output_path)"
   ]
  },
  {
   "cell_type": "markdown",
